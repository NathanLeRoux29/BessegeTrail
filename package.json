{
  "name": "bessege-trail",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "docker compose up",
    "dev:site": "pnpm --filter @bessege/site dev",
    "dev:admin": "pnpm --filter @bessege/admin dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --recursive --parallel typecheck && tsc",
    "test": "pnpm --recursive test && vitest run",
    "test:docker": "vitest run --config docker/vitest.config.ts",
    "test:e2e": "docker compose --file docker/compose.e2e.yaml build && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "catalog:",
    "eslint": "^10.13.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  }
}
