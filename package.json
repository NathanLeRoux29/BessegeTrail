{
  "name": "bessege-trail",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev:site": "pnpm --filter @bessege/site dev",
    "dev:admin": "pnpm --filter @bessege/admin dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --recursive --parallel typecheck && tsc --project docker",
    "test": "pnpm --recursive test",
    "test:docker": "vitest run --config docker/vitest.config.ts"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@types/node": "catalog:",
    "eslint": "^10.13.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
